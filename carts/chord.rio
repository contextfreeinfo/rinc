# play it: sound(0, chord, 4, 1, 22050.0)
fine: [11025]Float
pluck :: proc(f: Float, start: Int)
  for i in start..<11025
    t := (i - start).toFloat() / 22050.0
    fine[i] += 0.22 * exp(-6.0 * t) * (sin(6.2831853 * f * t) + 0.3 * sin(12.566371 * f * t))
  end
end
pluck(220.0, 0)
pluck(261.63, 1102)
pluck(329.63, 2204)
pluck(440.0, 3306)
chord16: Blob[22050]
chord8: Blob[11025]
for x, i in fine
  v := max(min((x * 32767.0).toInt(), 32767), -32768)
  chord16[i * 2] = v & 255
  chord16[i * 2 + 1] = (v >> 8) & 255
  chord8[i] = max(min(round(x * 127.0).toInt(), 127), -128) & 255
end

pitch := 1.0
pan := 0.0
next := 0
held := 0
last := "ADPCM"

update* :: proc()
  pressed := btn(4) + btn(5) * 2 + btn(6) * 4
  if btn(0) == 1
    pitch = max(pitch * 0.99, 0.25)
  end
  if btn(1) == 1
    pitch = min(pitch * 1.01, 4.0)
  end
  if btn(2) == 1
    pan = max(pan - 0.02, -1.0)
  end
  if btn(3) == 1
    pan = min(pan + 0.02, 1.0)
  end
  if pressed & 1 == 1 and held & 1 == 0
    sound(next, chord, 4, 1, 22050.0 * pitch)
    next = (next + 1) % 8
    last = "ADPCM"
  end
  if pressed & 2 == 2 and held & 2 == 0
    sound(next, chord16, 16, 1, 22050.0 * pitch)
    next = (next + 1) % 8
    last = "16-BIT"
  end
  if pressed & 4 == 4 and held & 4 == 0
    sound(next, chord8, 8, 1, 22050.0 * pitch)
    next = (next + 1) % 8
    last = "8-BIT"
  end
  held = pressed
  for k in 0..<8
    soundRate(k, 22050.0 * pitch)
    soundPan(k, pan)
  end
end

draw* :: proc()
  cls(1)
  print("CHORD: ADPCM 5590 B, 16-BIT 22050, 8-BIT 11025", 8, 8, 7)
  print("V: ADPCM   C: 16-BIT   X: 8-BIT", 8, 24, 6)
  print("LEFT/RIGHT: PITCH   UP/DOWN: PAN", 8, 34, 6)
  print(last, 8, 110, 10)
  for k in 0..<8
    if soundPlaying(k) == 1
      rect(8 + k * 14, 60, 10, 10, 8 + k)
    else
      rect(8 + k * 14, 60, 10, 10, 5)
    end
  end
  rect(8, 80, 120, 4, 5)
  rect(8 + ((pitch - 0.25) / 3.75 * 116.0).toInt(), 78, 4, 8, 10)
  rect(8, 96, 120, 4, 5)
  rect(66 + (pan * 58.0).toInt(), 94, 4, 8, 12)
end
