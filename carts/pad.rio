# Pad: what a controller (or the keyboard) is doing. Each button lights up while held; the sticks
# move their dots, and the triggers fill their bars. Changes also go to the log.
names := "LEFT RIGHTUP   DOWN A    B    X    Y    LB   RB   LS   RS   STARTBACK "
last := -1

update* :: proc()
  bits := 0
  for i in 0..<14
    bits |= btn(i) << i
  end
  if bits != last
    log("buttons", bits, "sticks", stick(0), stick(1), stick(2), stick(3), "triggers", trigger(0), trigger(1))
    last = bits
  end
end

dot :: proc(x: Int, y: Int, sx: Float, sy: Float, c: Int)
  rect(x, y, 61, 61, 5)
  rect(x + 28 + (sx * 28.0).toInt(), y + 28 + (sy * 28.0).toInt(), 5, 5, c)
end

draw* :: proc()
  cls(1)
  print("PAD: HOLD BUTTONS, MOVE STICKS", 8, 8, 7)
  for i in 0..<14
    x := 8 + (i % 7) * 44
    y := 24 + (i / 7) * 16
    c := 5
    if btn(i) == 1
      c = 11
    end
    rect(x, y, 40, 12, c)
    print(names[i * 5:i * 5 + 5], x + 3, y + 2, 7)
  end
  dot(8, 64, stick(0), stick(1), 8)
  dot(80, 64, stick(2), stick(3), 12)
  rect(160, 64, 10, 61, 5)
  rect(160, 64 + 61 - (trigger(0) * 61.0).toInt(), 10, (trigger(0) * 61.0).toInt(), 9)
  rect(176, 64, 10, 61, 5)
  rect(176, 64 + 61 - (trigger(1) * 61.0).toInt(), 10, (trigger(1) * 61.0).toInt(), 9)
end
