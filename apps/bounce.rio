# Bounce: the arrow keys tilt gravity, V adds a ball, C shakes them all. Walls go blip
Ball :: struct
  x, y, dx, dy: Float
  c: Int
end

balls: [..512]Ball
blip: Blob[1200] # a falling square wave, 8-bit, played at 22050 a second
for i in 0..<1200
  v := (1200 - i) / 30 # (a third of full scale: square waves are harsh)
  if i / 12 % 2 == 1
    v = -v
  end
  blip[i] = v & 255
end
gx := 0.0
gy := 0.15
held := false
tick := 0

add :: proc()
  n := balls.len()
  # Use n for simple variance, but always have some nonzero dx.
  ok := balls.push(Ball{x = 160.0, y = 40.0, dx = (n % 8).toFloat() - 3.5, dy = 0.0, c = 8 + n % 8})
end
add()

update* :: proc()
  tick += 1
  # TODO What really is going on here?
  gx = (pc.btn(1) - pc.btn(0)).toFloat() * 0.15
  gy = (pc.btn(3) - pc.btn(2)).toFloat() * 0.15 + 0.15
  if pc.btn(4) == 1 and not held
    add()
  end
  held = pc.btn(4) == 1
  for b, k in balls
    hit := false
    if pc.btn(5) == 1
      # Include some variance also in the shake.
      b.dy -= 1.0 + 0.05 * ((k % 7).toFloat() - 3.0)
    end
    b.dx += gx
    b.dy += gy
    b.x += b.dx
    b.y += b.dy
    if b.x < 4.0 or b.x > 316.0
      b.dx = -b.dx * 0.9
      b.x = max(4.0, min(b.x, 316.0))
      hit = abs(b.dx) > 0.5
    end
    if b.y < 4.0 or b.y > 236.0
      b.dy = -b.dy * 0.9
      b.y = max(4.0, min(b.y, 236.0))
      hit = hit or abs(b.dy) > 0.5
    end
    if hit # its own voice, pitched by color, panned by where it hit
      pc.sound(k % 8, blip, 8, 1, 16000.0 + (b.c - 8).toFloat() * 3000.0)
      pc.soundPan(k % 8, b.x / 160.0 - 1.0)
    end
  end
end

draw* :: proc()
  pc.cls(0)
  for b in balls
    pc.rect(b.x.toInt() - 4, b.y.toInt() - 4, 8, 8, b.c)
  end
  pc.print("arrows tilt  V adds  C shakes", 4, 4, 6)
  # Report ball count.
  report: Blob[..100]
  report.clear()
  report.format("count: ", balls.len())
  pc.print(report[:].asString(), 4, 13, 6)
end
