; I2S out: 16-bit stereo, MSB first, word select changing a bit before each word (standard I2S).
; OUT pin: data. Side-set pins: bit clock, then word select. Two PIO cycles a bit; 64 a frame.
; Each 32-bit word: left in the top half, right in the bottom.

.program rim_i2s
.side_set 2
.wrap_target
    set x, 14       side 0b01   ; left word: 15 bits in the loop, the 16th as word select turns
lbits:
    out pins, 1     side 0b00
    jmp x-- lbits   side 0b01
    out pins, 1     side 0b10
    set x, 14       side 0b11   ; right word
rbits:
    out pins, 1     side 0b10
    jmp x-- rbits  side 0b11
    out pins, 1     side 0b00
.wrap
