# cmake -DWASM=rinc.wasm -DPAGE=src/web/page.html -DOUT=web_player.c -P tools/embed.cmake
# The web player as C arrays, for rinc -web: the VM-only wasm (tools/web.py --wasm=...) and the page
# around it (0-terminated).
file(READ ${WASM} wasm HEX)
file(READ ${PAGE} page HEX)
string(LENGTH "${wasm}" n)
math(EXPR wasm_size "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," wasm "${wasm}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," page "${page}")
file(WRITE ${OUT} "/* generated by tools/embed.cmake: the web player, for rinc -web */\n"
  "const unsigned char rinc_webWasm[] = {${wasm}};\n"
  "const unsigned rinc_webWasmSize = ${wasm_size};\n"
  "const char rinc_webPage[] = {${page}0};\n")
