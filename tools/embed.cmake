# cmake -DWASM=rinc.wasm [-DWASM_FULL=rinc-full.wasm] -DPAGE=src/web/page.html -DOUT=web_player.c -P tools/embed.cmake
# The web players as C arrays, for rinc -web: the VM-only wasm and, if given, the one with the compiler
# (tools/web.py --wasm=... --wasm-full=...), each gzipped (the page unzips it), and the page around them
# (0-terminated).
cmake_minimum_required(VERSION 3.18)
get_filename_component(dir ${OUT} DIRECTORY)
function(embed var wasm)
  set(gz ${dir}/${var}.wasm.gz)
  file(ARCHIVE_CREATE OUTPUT ${gz} PATHS ${wasm} FORMAT raw COMPRESSION GZip)
  file(READ ${gz} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  set(${var} "const unsigned char ${var}[] = {${hex}};\nconst unsigned ${var}Size = ${size};\n" PARENT_SCOPE)
endfunction()
embed(rinc_webWasm ${WASM})
if(WASM_FULL)
  embed(rinc_webWasmFull ${WASM_FULL})
else()
  set(rinc_webWasmFull "const unsigned char rinc_webWasmFull[1];\nconst unsigned rinc_webWasmFullSize = 0;\n")
endif()
file(READ ${PAGE} page HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," page "${page}")
file(WRITE ${OUT} "/* generated by tools/embed.cmake: the web players, gzipped, for rinc -web */\n"
  "${rinc_webWasm}${rinc_webWasmFull}"
  "const char rinc_webPage[] = {${page}0};\n")
